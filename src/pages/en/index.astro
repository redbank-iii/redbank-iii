</section>

<!-- ============ BOM A ============ -->


<!-- ============ BOM B ============ -->
<section class="section section-dark" id="bom-b">
  <div class="container">
    <div class="section-eyebrow">BOM · 物料清单</div>
    <h2 class="section-title">Phone Conversion Plan — Bill of Materials</h2>
    <div class="bom-table-wrap">
      <table class="bom-table">
        <thead>
          <tr><th>Component</th><th>Model / source</th><th>Qty</th><th>Unit</th><th>Subtotal</th></tr>
        </thead>
        <tbody>
          <tr><td>Donor phone board</td><td>Xiaomi 11 Ultra (cracked screen/back, intact mainboard + camera)</td><td>1</td><td>$50</td><td>$50</td></tr>
          <tr><td>Conversion labor</td><td>Huaqiangbei conversion technician (lens removal + cleaning + assembly)</td><td>1</td><td>$3</td><td>$3</td></tr>
          <tr><td>Astrograph lens</td><td>Samyang 135mm f/2.0 (Canon EF)</td><td>1</td><td>$500</td><td>$500</td></tr>
          <tr><td>Adapter ring</td><td>Canon EF → phone sensor (custom CNC)</td><td>1</td><td>$25</td><td>$25</td></tr>
          <tr><td>Enclosure</td><td>CNC aluminium enclosure (heatsinked)</td><td>1</td><td>$30</td><td>$30</td></tr>
          <tr><td>Focuser</td><td>M42 focuser (standard astro part)</td><td>1</td><td>$10</td><td>$10</td></tr>
          <tr><td>Misc</td><td>Seals, IR-cut filter, screws, etc.</td><td>1</td><td>$15</td><td>$15</td></tr>
