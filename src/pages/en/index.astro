<!-- ============ BOM B ============ -->
<section class="section section-dark" id="bom-b">
  <div class="container">
    <div class="section-eyebrow">BOM · 物料清单</div>
    <h2 class="section-title">Phone Conversion Plan — Bill of Materials</h2>
    <div class="bom-table-wrap">
      <table class="bom-table">
        <thead>
          <tr><th>Component</th><th>Model / 来源</th><th>Qty</th><th>Unit</th><th>Subtotal</th></tr>
        </thead>
        <tbody>
          <tr><td>Donor phone board</td><td>Xiaomi 11 Ultra (cracked screen/back, intact mainboard + camera)</td><td>1</td><td>$50</td><td>$50</td></tr>
          <tr><td>Conversion labor</td><td>华强北改机师傅 (拆Lens组 + 清洁 + 组装)</td><td>1</td><td>$3</td><td>$3</td></tr>
          <tr><td>天文Lens</td><td>Samyang 135mm f/2.0 (Canon EF)</td><td>1</td><td>$500</td><td>$500</td></tr>
          <tr><td>Adapter ring</td><td>Canon EF → 手机Sensor (CNC 定制)</td><td>1</td><td>$25</td><td>$25</td></tr>
          <tr><td>Enclosure</td><td>铝合金 CNC Enclosure (含散热)</td><td>1</td><td>$30</td><td>$30</td></tr>
          <tr><td>Focuser</td><td>M42 Focuser (天文标准件)</td><td>1</td><td>$10</td><td>$10</td></tr>
          <tr><td>Misc</td><td>Seals, IR-cut filter, screws, etc.</td><td>1</td><td>$15</td><td>$15</td></tr>
          <tr><td>Incoming QC + burn-in</td><td>Power-on test + lightbox MTF test</td><td>1</td><td>$5</td><td>$5</td></tr>
        </tbody>
