<script>
  // starfield canvas
  (() => {
    const canvas = document.getElementById('starfield');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, stars = [], meteors = [];
    function resize() {
      w = canvas.width = canvas.offsetWidth * devicePixelRatio;
      h = canvas.height = canvas.offsetHeight * devicePixelRatio;
      initStars();
    }
    function initStars() {
      stars = [];
      const count = Math.floor((w * h) / 8000);
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * w, y: Math.random() * h,
          r: Math.random() * 1.2 * devicePixelRatio,
          baseAlpha: 0.3 + Math.random() * 0.7,
          twinkleSpeed: 0.5 + Math.random() * 1.5,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }
    function spawnMeteor() {
      if (Math.random() > 0.997) {
        meteors.push({
          x: Math.random() * w, y: Math.random() * h * 0.5,
          vx: (2 + Math.random() * 3) * devicePixelRatio,
          vy: (1 + Math.random() * 1.5) * devicePixelRatio,
          life: 1.0,
        });
      }
    }
    function draw(t) {
      ctx.clearRect(0, 0, w, h);
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, '#0a0e1a');
      grad.addColorStop(1, '#060912');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);
      for (const s of stars) {
        const tw = Math.sin(t * 0.001 * s.twinkleSpeed + s.phase) * 0.3 + 0.7;
        const alpha = s.baseAlpha * tw;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(232, 236, 244, ${alpha})`;
        ctx.fill();
        if (s.r > 1.0 * devicePixelRatio) {
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r * 3, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(91, 157, 255, ${alpha * 0.15})`;
          ctx.fill();
        }
      }
      spawnMeteor();
      meteors = meteors.filter(m => m.life > 0);
      for (const m of meteors) {
        const grad = ctx.createLinearGradient(m.x, m.y, m.x - m.vx * 20, m.y - m.vy * 20);
        grad.addColorStop(0, `rgba(255, 217, 122, ${m.life})`);
        grad.addColorStop(1, 'rgba(255, 217, 122, 0)');
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.5 * devicePixelRatio;
        ctx.beginPath();
        ctx.moveTo(m.x, m.y);
        ctx.lineTo(m.x - m.vx * 20, m.y - m.vy * 20);
        ctx.stroke();
        m.x += m.vx; m.y += m.vy; m.life -= 0.015;
      }
      requestAnimationFrame(draw);
    }
    resize();
    window.addEventListener('resize', resize);
    requestAnimationFrame(draw);
  })();
</script>

