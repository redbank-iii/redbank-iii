---
// Main layout — wraps all pages with nav, footer, starfield
import { languages, ui, defaultLang, t } from '../i18n/ui.js';

export interface Props {
  lang?: keyof typeof ui;
  title?: string;
  description?: string;
}

const { lang = defaultLang, title = 'Redbank III 红岸三号', description = 'Open source array telescope' } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// base may or may not carry a trailing slash — normalize to `baseWithSlash`
// so `${baseWithSlash}${lang}/` always produces e.g. `/zh/`, never `/zh` glued to the base.
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
// strip locale prefix from path for language switcher
const pathWithoutLocale =
  currentPath.replace(new RegExp(`^${baseWithSlash}(zh|en|fr)?`), '') || '/';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;900&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style is:global>
  @import '../styles/global.css';
</style>
</head>
<body>

<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href={`${baseWithSlash}${lang}/`} class="nav-logo">
      <span class="logo-mark">◉</span>
      <span class="logo-text">REDBANK <em>III</em></span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-label={t(lang, 'nav.menu')} aria-controls="nav-links" aria-expanded="false">☰</button>
    <div class="nav-links" id="nav-links">
      <a href="#mission">{t(lang, 'nav.mission')}</a>
      <a href="#design">{t(lang, 'nav.design')}</a>
      <a href="#plans">{t(lang, 'nav.plans')}</a>
      <a href="#array">{t(lang, 'nav.array')}</a>
      <a href="#sim">{t(lang, 'nav.sim')}</a>
      <a href="#story">{t(lang, 'nav.story')}</a>
      <a href="#open">{t(lang, 'nav.open')}</a>
      <a href="#join" class="nav-cta">{t(lang, 'nav.join')}</a>
      <div class="lang-switcher">
        {Object.entries(languages).map(([code, name]) => (
          <a
            href={`${baseWithSlash}${code}${pathWithoutLocale}`}
            class:list={['lang-link', { active: code === lang }]}
          >
            {code.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<slot />

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-logo">◉ REDBANK III</div>
        <p style="white-space: pre-line">{t(lang, 'footer.tagline')}</p>
      </div>
      <div class="footer-col">
        <h4>{t(lang, 'nav.plans')}</h4>
        <a href="#plans">{t(lang, 'nav.plans')}</a>
        <a href="#array">{t(lang, 'nav.array')}</a>
        <a href={lang === 'zh' ? '#bom-main' : '#bom-b'}>BOM</a>
      </div>
      <div class="footer-col">
        <h4>Resources</h4>
        <a href="https://github.com/redbank-iii">GitHub</a>
        <a href="https://github.com/redbank-iii/redbank-iii/tree/main/docs">Docs</a>
        <a href="https://redbank-twin.liyao.space/">Simulation replays</a>
      </div>
      <div class="footer-col">
        <h4>Community</h4>
        <a href="https://github.com/redbank-iii/redbank-iii/issues">GitHub Issues</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Hardware: CERN-OHL-W-2.0 · Software: Apache-2.0 · Docs: CC BY-SA 4.0 · Data: CC0</p>
      <p>{t(lang, 'footer.motto')}</p>
      <p class="image-credits">Images: NASA/ESA/STScI · ESO/Bruno Gilli · ESO/M. Montargès et al. · NASA/CXC/RIKEN/D. Takei et al. · NASA/Swift/A. Beardmore (Univ. of Leicester) · International Gemini Observatory/NOIRLab/NSF/AURA/J. Miller et al. — ESO &amp; NOIRLab images CC BY 4.0</p>
    </div>
  </div>
</footer>

<script>
  // nav hide on scroll
  let lastY = 0;
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 100 && y > lastY) nav?.classList.add('hidden');
    else nav?.classList.remove('hidden');
    lastY = y;
  }, { passive: true });

  // mobile nav toggle
  const navToggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');
  navToggle?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  if (navLinks) {
    navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      navLinks.classList.remove('open');
      navToggle?.setAttribute('aria-expanded', 'false');
    }));
  }

  // 3D viewer loads on demand — 4 MB of wasm is not something to spend on every
  // visitor who merely scrolls past the design section.
  document.querySelectorAll('.viewer-embed').forEach((box) => {
    const btn = box.querySelector('.viewer-load');
    btn?.addEventListener('click', () => {
      const src = box.getAttribute('data-viewer-src');
      if (!src) return;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = 'Redbank III interactive URDF viewer';
      frame.setAttribute('allow', 'fullscreen');
      box.replaceChildren(frame);
    });
  });

  // Off-site links carry a ↗ affordance, so honour it: open in a new tab and keep
  // this page alive. Matters most for the simulation host, which lives on a
  // separate box and can be offline — a visitor who hits an error still has us open.
  document.querySelectorAll('a[href^="http"]').forEach((a) => {
    if (a.host && a.host !== location.host && !a.target) {
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
    }
  });

  // scroll fade-in
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
      }
    }
  }, { threshold: 0.1 });

  document.querySelectorAll('.section, .plan-card, .principle, .timeline-item, .open-item, .join-item, .science-card').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(24px)';
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    io.observe(el);
  });

  // vs-bar animation
  const vsObserver = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.vs-bar').forEach(bar => {
          bar.style.width = bar.style.getPropertyValue('--pct');
        });
      }
    }
  }, { threshold: 0.3 });
  const vsGrid = document.querySelector('.vs-grid');
  if (vsGrid) vsObserver.observe(vsGrid);
</script>

</body>
</html>
